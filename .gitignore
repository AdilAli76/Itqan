#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# مخرجات Gradle — تُبنى بـ flutter build apk ولا تُرفع (مئات الميغابايت
# ومسارات مطلقة على جهاز المطوّر).
/android/build/
/android/.gradle/

# إعدادات أدوات محلية — تحوي مسارات مطلقة على جهاز المطوّر (مسار Flutter SDK)
# لا تصلح لجهاز آخر
.claude/

# ---------------------------------------------------------------------------
# .NET Backend — مخرجات البناء (عشرات الميغابايت، تُبنى من المصدر)
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
*.user

# ---------------------------------------------------------------------------
# الأسرار — لا تُرفع أبداً
#
# appsettings.json المُرفوع يحوي قيماً فارغة فقط؛ القيم الحقيقية (سلسلة
# الاتصال ومفتاح توقيع JWT) تعيش هنا وحدها أو في متغيّرات البيئة.
# مفتاح JWT مسرَّب = إمكانية تزوير توكن لأي مستخدم في أي منظمة على السيرفر.
# ---------------------------------------------------------------------------
appsettings.Production.json
appsettings.Development.json
appsettings.Local.json
*.pfx
*.snk

# نسخ قاعدة البيانات الاحتياطية
*.bak
*.mdf
*.ldf

# ---------------------------------------------------------------------------
# حزمة النشر — تُبنى بـ tool/publish.ps1 عند الحاجة، ولا تُرفع:
# عشرات الميغابايت من مخرجات بناء يعاد توليدها من المصدر في دقيقتين.
# ---------------------------------------------------------------------------
/publish/
/publish.zip
# والاسم صار مؤرَّخاً — راجع publish.ps1. وبلا هذا السطر تدخل
# أربع حزم بمئتي ميغابايت في أول «git add -A».
/kinetic_pkg_*.zip

# مفاتيح توقيع أندرويد — فقدان المفتاح يعني عدم القدرة على نشر أي تحديث
# لنفس التطبيق مستقبلاً، وتسريبه يعني قدرة غيرك على توقيع نسخة باسمك.
android/key.properties
*.jks
*.keystore
*.pfx

# ملفات تشغيل محلية قد تحمل مسارات أو بيانات دخول خاصة بالجهاز
*.local.bat

# ناتج فشل الاختبارات الذهبية — يُولَّد ولا يُرفع
test/failures/
