<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- شاشة الإقلاع (أندرويد 11 وأقدم) — تُزال تلقائياً عند رسم Flutter
         لأول إطار. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- خلفية النافذة بعد بدء العملية وأثناء تهيئة واجهة Flutter. مضبوطة على
         AppColors.paper لأن التطبيق لا يملك ثيماً ليلياً (MaterialApp يمرّر
         theme فقط)، فلو تُركت على colorBackground لظهرت وميضة سوداء لمستخدمي
         الوضع الليلي قبل ظهور واجهة فاتحة. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
